       
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rule Definition",
  "type": "object",
  "properties": {
    "when": 
    {
  "type": "object",
  "title": "When",
  "description": "Conditions (all, any) that must be satisfied before the rule executes",
  "properties": {
    "all": {
      "type": "array",
      "title": "All Conditions (AND)",
      "format": "table",
      "options": {
        "compact": true
        },
      "items": {
        "type": "object",
        "properties": {
          "fact": { "type": "string", "title": "Fact" },
          "operator": { "type": "string", "title": "Operator" },
          "value": {"type": "string","title": "Value"}
        },
        "required": ["fact", "operator", "value"]
      }
    },
    "any": {
      "type": "array",
      "title": "Any Conditions (OR)",
      "format": "table",
      "options": {
        "compact": true
        },
      "items": {
        "type": "object",
        "properties": {
          "fact": { "type": "string", "title": "Fact" },
          "operator": { "type": "string", "title": "Operator" },
          "value": {"type": "string","title": "Value"}
        },
        "required": ["fact", "operator", "value"]
      }
    }
  },
  "minProperties": 1
}
,

    "then": {
  "type": "object",
  "title": "Then",
  "properties": {
    "do": {
      "type": "string",
      "title": "Action",
      "enum": ["advice", "apply-adjustment", "validation"]
    },
    "with": {
      "type": "object",
      "title": "Parameters",
      "properties": {
        "item": { "type": "string", "title": "Item" },
        "message": {
          "type": "string",
          "title": "Message",
          "format": "textarea",
          "options": {
            "inputAttributes": {
              "rows": 2,
              "style": "width: 100%;"
            }
          }
        },

        "break": { "type": "boolean", "title": "Break Execution" },
        "mode": {
          "type": "string",
          "title": "Mode",
          "enum": [
            "fixed",
            "rate",
            "range-lookup",
            "value-lookup",
            "value-range-lookup",
            "expression"
          ],
          "description": "Determines which kind of adjustment to perform"
        }
      },
      "required": ["item", "message"],
      "oneOf": [
        {
          "title": "Fixed Value",
          "properties": {
            "mode": { "const": "fixed" },
            "value": { "type": ["number", "string"], "title": "Value" }
          },
          "required": ["mode", "value"]
        },
        {
          "title": "Rate (Percentage)",
          "properties": {
            "mode": { "const": "rate" },
            "base": { "type": "string", "title": "Base Fact" },
            "value": { "type": "number", "title": "Rate Multiplier (e.g., 0.002)" }
          },
          "required": ["mode", "base", "value"]
        },
        {
          "title": "Range Lookup",
          "properties": {
            "mode": { "const": "range-lookup" },
            "base": { "type": "string", "title": "Base Fact" },
            "table": {
              "type": "object",
              "title": "Range Table",
              "additionalProperties": { "type": "number" }
            },
            "default": { "type": "number", "title": "Default Value" }
          },
          "required": ["mode", "base", "table", "default"]
        },
        {
          "title": "Value Lookup",
          "properties": {
            "mode": { "const": "value-lookup" },
            "base": { "type": "string", "title": "Base Fact" },
            "table": {
              "type": "object",
              "title": "Value Table",
              "additionalProperties": { "type": "string" }
            },
            "default": { "type": "string", "title": "Default Value" }
          },
          "required": ["mode", "base", "table", "default"]
        },
        {
          "title": "Value + Range Lookup",
          "properties": {
            "mode": { "const": "value-range-lookup" },
            "key": { "type": "string", "title": "Outer Key Fact" },
            "base": { "type": "string", "title": "Base Fact" },
            "table": {
              "type": "object",
              "title": "Nested Lookup Table",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": { "type": "number" }
              }
            },
            "default": { "type": "number", "title": "Default Value" }
          },
          "required": ["mode", "key", "base", "table", "default"]
        },
        {
          "title": "Expression",
          "properties": {
            "mode": { "const": "expression" },
            "value": {
              "type": "string",
              "title": "Expression",
              "description": "A string formula, e.g., 'grossPremium + stampDuty + itl'"
            },
            "context": {
              "type": "array",
              "title": "Referenced Facts",
              "items": { "type": "string" },
              "description": "List of facts referenced in the expression"
            }
          },
          "required": ["mode", "value", "context"]
        }
      ]
    }
  },
  "required": ["do", "with"],
  "allOf": [
    {
      "if": { "properties": { "do": { "const": "validation" } } },
      "then": {
        "properties": {
          "with": {
            "required": ["message"],
            "properties": {
              "break": { "type": "boolean" }
            }
          }
        }
      }
    }
  ]
}
,

    "priority": {
      "type": "integer",
      "title": "Priority",
      "minimum": 0
    }
  },
  "required": ["when", "then", "priority"]
}