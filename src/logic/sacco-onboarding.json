[
  {
  "when": { 
    "all": [{ "fact": "dob", "operator": "notEqual", "value":"" }] },
  "then": {
    "do": "apply-adjustment",
    "with": { 
        "item": "age", 
        "mode": "expression", 
        "value": "age(dob)", 
        "context": ["dob"], 
        "message": "Compute member age from DOB" 
        }
      },
    "priority": 500
  },
  {
    "when": { "all": [{ "fact": "age", "operator": "lessThan", "value": 18 }] },
    "then": {
      "do": "validation",
      "with": { "message": "Member must be at least 18 years old", "break": true }
    },
    "priority": 400
  },
  {
    "when": { "all": [{ "fact": "initialContribution", "operator": "lessThan", "value": 1000 }] },
    "then": {
      "do": "validation",
      "with": { "message": "Minimum initial contribution is 1000/-", "break": true }
    },
    "priority": 400
  }
]
