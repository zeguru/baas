[
    {
      "conditions": {
        "any": [
            { "fact": "model", "operator": "in", "value": ["VITZ", "DEMIO", "MARCH"]}
            ]
        },
      "event": {
        "type": "validation",
        "params": {"break": true, "message": "Vehicle model is blacklisted" }        
        },
      "priority": 500
      },

    {
      "conditions": {
        "all": [
          {"fact": "yearOfManufacture", "operator": "lessThan", "value": 2000}
          ]
        },
      "event": {
        "type": "validation",
        "params": {"break": true, "message": "Vehicle year of manufacture is below the allowed age (2000)."}
        },
      "priority": 500
      },

      {
        "conditions": {
          "any": [
            {"fact":"sumInsured", "operator": "lessThan", "value": 600000},
            {"fact":"sumInsured","operator": "greaterThan", "value": 50000000}
            ]
        },
        "event": {
          "type": "validation",
            "params": { "break": true, "message": "Car value is NOT within the allowed range (600K - 50M)."}
            
          },
      "priority": 500
      },
      
      {
      "conditions": {
        "all": [{ "fact": "courtesyCarDays", "operator": "greaterThan", "value": 20 }] },
      "event": {
        "type": "validation",
        "params": {"break": true, "message": "Courtesy car is only 10 or 20 days. Above that kindly visit the backoffice" }        
        },
      "priority": 500
      },

      {
        "conditions": {
          "all": [
            {"fact":"sumInsured", "operator": "greaterThanInclusive", "value": 600000},
            {"fact":"sumInsured","operator": "lessThanInclusive", "value": 999999}
            ]
        },
        "event": {
            "type": "apply-adjustment", 
            "params": { "item": "basePremium", "mode": "rate", "base":"sumInsured", "value": 0.0725, 
              "message": "Charge 7.25% for sum insured  between 6K - 999,999"}
            },
      "priority": 400
      },

      {
        "conditions": {
          "all": [
            {"fact":"sumInsured", "operator": "greaterThanInclusive", "value": 1000000},
            {"fact":"sumInsured","operator": "lessThanInclusive", "value": 1499999}
            ]
        },
        "event": {
            "type": "apply-adjustment", 
            "params": { "item": "basePremium", "mode": "rate", "base":"sumInsured", "value": 0.0615, 
              "message": "Charge 6.15% for sum insured  between 1M - 1.49M"}
            },
      "priority": 400
      },

      {
        "conditions": {
          "all": [
            {"fact":"sumInsured", "operator": "greaterThanInclusive", "value": 1500000},
            {"fact":"sumInsured", "operator": "lessThanInclusive", "value": 2499999}
            ]
        },
        "event": {
            "type": "apply-adjustment", 
            "params": { "item": "basePremium", "mode": "rate", "base":"sumInsured", "value": 0.0475, 
              "message": "Charge 4.75% for sum insured  between 1.5M - 2.49M"}
            },
      "priority": 400
      },

      {
        "conditions": {
          "any": [
            {"fact":"sumInsured", "operator": "greaterThanInclusive", "value": 2500000}    
            ]
        },
        "event": {
            "type": "apply-adjustment", 
            "params": { "item": "basePremium", "mode": "rate", "base":"sumInsured", "value": 0.03875, 
              "message": "Charge 3.875% for sum insured  greater than 2.5"}
            },
        "priority": 400
      },
     

      {
      "conditions": {
          "all": [{ "fact": "aaMembership", "operator": "equal", "value": true }] },
      "event": {
        "type": "apply-adjustment",
            "params": { "item": "aaCharge", "mode": "fixed", "base": "total", "value": 5000, 
          "message": "AA Membership: Charge 5k fixed"}
        },
        "priority": 300
      },

     {
      "conditions": {
          "all": [{ "fact":"sumInsured", "operator": "greaterThan", "value": 1 }] },
      "event": {
        "type": "apply-adjustment",
            "params": { "item": "pvt", "mode": "fixed", "base": "total", "value": 0, "action": "nop", 
          "message": "Inclusive: Post Election Violence and Terrorism - PVT Benefit. No extra charge "}
        },
        "priority": 300
      },

      {
      "conditions": {
          "all": [{ "fact":"sumInsured", "operator": "greaterThan", "value": 1 }] },
      "event": {
        "type": "apply-adjustment",
            "params": { "item": "exp", "mode": "fixed", "base": "total", "value": 0.0, "action": "nop", 
          "message": "Inclusive: Excess Protector Benefit. No extra charge "}
        },
        "priority": 300
      },

      {
      "conditions": {
          "all": [{ "fact": "windscreenValue", "operator": "lessThanInclusive", "value": 50000 }] },
      "event": {
        "type": "apply-adjustment",
            "params": { "item": "windscreenCharge", "mode": "fixed", "base": "total", "value": 0.0, 
          "message": "Free Benefit: Windscreen benefit if value below 50K. No extra charge "}
        },
        "priority": 300
      },

      
      {
      "conditions": {
          "all": [{ "fact": "windscreenValue", "operator": "greaterThan", "value": 50000 }] },
      "event": {
        "type": "apply-adjustment",
            "params": { "item": "windscreenCharge", "mode": "expression", "value":"(windscreenValue - 50000) * 0.1",  "context": ["windscreenValue","sumInsured"], 
          "message": "Windscreen: Charge 10% of the (extra) amount above 50k"}
        },
        "priority": 300
      },

      {
      "conditions": {
          "all": [{ "fact": "entertainmentValue", "operator": "lessThan", "value": 50000 }] },
      "event": {
        "type": "apply-adjustment",
            "params": { "item": "entertainmentCharge", "mode": "fixed", "base": "total", "value": 0, "action": "nop", 
          "message": "Free Benefit: Entertainment benefit because value is below 50K. No extra charge "}
        },
        "priority": 300
      },

            
      {
      "conditions": {
          "all": [{ "fact": "entertainmentValue", "operator": "greaterThan", "value": 50000 }] },
      "event": {
        "type": "apply-adjustment",
            "params": { "item": "entertainmentCharge", "mode": "expression", "value":"(entertainmentValue - 50000) * 0.1", "context": ["entertainmentValue","sumInsured"], 
          "message": "Entertainment: Charge 10% of the (extra) amount above 50k"}
        },
        "priority": 300
      },


      {
      "conditions": {
          "all": [{ "fact": "courtesyCarDays", "operator": "lessThanInclusive", "value": 10 }] },
      "event": {
        "type": "apply-adjustment",
            "params": { "item": "courtesyCarCharge", "mode": "fixed", "base": "total", "value": 3000, 
          "message": "Charge 3k for 10 day Courtesy car"}
        },
        "priority": 300
      },

      {
      "conditions": {
          "all": [
            {"fact": "courtesyCarDays", "operator": "greaterThan", "value": 10},
            {"fact": "courtesyCarDays","operator": "lessThanInclusive", "value": 20}
            ]
        },
      "event": {
        "type": "apply-adjustment",
            "params": { "item": "courtesyCarCharge", "mode": "fixed", "base": "total", "value": 6000, 
          "message": "Charge 6k for 20 day Courtesy car"}
        },
        "priority": 300
      },


      {
      "conditions": {
          "all": [{ "fact":"sumInsured", "operator": "greaterThanInclusive", "value": 1 }] },
      "event": {
        "type": "apply-adjustment",
            "params": { "item": "grossPremium", "mode": "expression", "value":"basePremium + aaCharge + windscreenCharge + entertainmentCharge + courtesyCarCharge", "context": ["basePremium", "aaCharge", "windscreenCharge","entertainmentCharge", "courtesyCarCharge"], "action": "nop", 
          "message": "Compute gross Premium"}
        },
        "priority": 250
      },


       {
        "conditions": { 
          "all": [{ "fact":"sumInsured", "operator": "greaterThan", "value": 1 }] },
        "event": { 
            "type": "apply-adjustment", 
            "params": { "item": "stampDuty", "mode": "fixed", "value": 40, 
            "message":"Add stamp duty. 40/- fixed"  } 
            },
        "priority": 200
      },
      {
        "conditions": { 
          "all": [{ "fact":"sumInsured", "operator": "greaterThan", "value": 1 }] },
        "event": { 
            "type": "apply-adjustment", 
            "params": { "item": "itl", "mode": "rate", "base": "grossPremium", "value": 0.002, 
            "message":"Add Training Levy. 0.2% of basePremium"  } 
            },
        "priority": 200
      },
      {
        "conditions": { 
          "all": [{ "fact":"sumInsured", "operator": "greaterThan", "value": 1 }] },
        "event": { 
            "type": "apply-adjustment", 
            "params": { "item": "phcf", "mode": "rate", "base": "grossPremium", "value": 0.0025, 
              "message":"Add PHCF 0.25% of basePremium"  } 
            },
        "priority": 200
      },

      {
      "conditions": {
          "all": [{ "fact":"sumInsured", "operator": "greaterThanInclusive", "value": 1 }] },
      "event": {
        "type": "apply-adjustment",
            "params": { "item": "totalPremium", "mode": "expression", "value":"grossPremium + stampDuty + itl + phcf", "context": ["grossPremium", "stampDuty", "itl","phcf"], "action": "nop", 
          "message": "Compute gross Premium"}
        },
        "priority": 100
      }
      
  ]

  
  