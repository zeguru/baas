[
    {
      "when": {
        "any": [
            { "fact": "model", "operator": "in", "value": ["VITZ", "DEMIO", "MARCH"]}
            ]
        },
      "then": {
        "do": "validation",
        "with": {"break": true, "message": "Vehicle model is blacklisted" }        
        },
      "priority": 500
      },

    {
      "when": {
        "all": [
          {"fact": "yearOfManufacture", "operator": "lessThan", "value": 2000}
          ]
        },
      "then": {
        "do": "validation",
        "with": {"break": true, "message": "Vehicle year of manufacture is below the allowed age (2000)."}
        },
      "priority": 500
      },

      {
        "when": {
          "any": [
            {"fact":"sumInsured", "operator": "lessThan", "value": 600000},
            {"fact":"sumInsured","operator": "greaterThan", "value": 50000000}
            ]
        },
        "then": {
          "do": "validation",
            "with": { "break": true, "message": "Car value is NOT within the allowed range (600K - 50M)."}
            
          },
      "priority": 500
      },
      
      {
      "when": {
        "all": [{ "fact": "courtesyCarDays", "operator": "greaterThan", "value": 20 }] },
      "then": {
        "do": "validation",
        "with": {"break": true, "message": "Courtesy car is only 10 or 20 days. Above that kindly visit the backoffice" }        
        },
      "priority": 500
      },

      {
      "when": { 
          "all": [{ "fact":"sumInsured", "operator": "greaterThan", "value": 1 }] },
      "then": { 
          "do": "apply-adjustment", 
          "with": {
              "item": "baseRate",
              "mode": "range-lookup",
              "base": "sumInsured",
              "table": {
                "600000-999999": 0.0725,
                "1000000-1499999": 0.0615,
                "1500000-2499999": 0.0475,
                "2500000-99000000": 0.03875
              },
              "default": 1,
              "message": "Lookup base rate from the table"
            }
          },
      "priority": 400

      },

      {
        "when": {
          "all": [{ "fact":"sumInsured", "operator": "greaterThan", "value": 1 }] },
        "then": {
            "do": "apply-adjustment", 
            "with": { "item": "basePremium", "mode": "expression", "value":"(sumInsured * baseRate)", "context": ["sumInsured","baseRate"], "base": "sumInsured",
              "message": "Compute base premium"}
            },
      "priority": 350
      },


      {
      "when": {
          "all": [{ "fact": "aaMembership", "operator": "equal", "value": true }] },
      "then": {
        "do": "apply-adjustment",
            "with": { "item": "aaCharge", "mode": "fixed", "base": "total", "value": 5000, 
          "message": "AA Membership: Charge 5k fixed"}
        },
        "priority": 300
      },

     {
      "when": {
          "all": [{ "fact":"sumInsured", "operator": "greaterThan", "value": 1 }] },
      "then": {
        "do": "apply-adjustment",
            "with": { "item": "pvt", "mode": "fixed", "base": "total", "value": 0,
          "message": "Inclusive: Post Election Violence and Terrorism - PVT Benefit. No extra charge "}
        },
        "priority": 300
      },

      {
      "when": {
          "all": [{ "fact":"sumInsured", "operator": "greaterThan", "value": 1 }] },
      "then": {
        "do": "apply-adjustment",
            "with": { "item": "exp", "mode": "fixed", "base": "total", "value": 0.0,
          "message": "Inclusive: Excess Protector Benefit. No extra charge "}
        },
        "priority": 300
      },

      {
      "when": {
          "all": [{ "fact": "windscreenValue", "operator": "lessThanInclusive", "value": 50000 }] },
      "then": {
        "do": "apply-adjustment",
            "with": { "item": "windscreenCharge", "mode": "fixed", "base": "total", "value": 0.0, 
          "message": "Free Benefit: Windscreen benefit if value below 50K. No extra charge "}
        },
        "priority": 300
      },

      
      {
      "when": {
          "all": [{ "fact": "windscreenValue", "operator": "greaterThan", "value": 50000 }] },
      "then": {
        "do": "apply-adjustment",
            "with": { "item": "windscreenCharge", "mode": "expression", "value":"(windscreenValue - 50000) * 0.1",  "context": ["windscreenValue","sumInsured"], 
          "message": "Windscreen: Charge 10% of the (extra) amount above 50k"}
        },
        "priority": 300
      },

      {
      "when": {
          "all": [{ "fact": "entertainmentValue", "operator": "lessThan", "value": 50000 }] },
      "then": {
        "do": "apply-adjustment",
            "with": { "item": "entertainmentCharge", "mode": "fixed", "base": "total", "value": 0, 
          "message": "Free Benefit: Entertainment benefit because value is below 50K. No extra charge "}
        },
        "priority": 300
      },

            
      {
      "when": {
          "all": [{ "fact": "entertainmentValue", "operator": "greaterThan", "value": 50000 }] },
      "then": {
        "do": "apply-adjustment",
            "with": { "item": "entertainmentCharge", "mode": "expression", "value":"(entertainmentValue - 50000) * 0.1", "context": ["entertainmentValue","sumInsured"], 
          "message": "Entertainment: Charge 10% of the (extra) amount above 50k"}
        },
        "priority": 300
      },


      {
      "when": {
          "all": [{ "fact": "courtesyCarDays", "operator": "lessThanInclusive", "value": 10 }] },
      "then": {
        "do": "apply-adjustment",
            "with": { "item": "courtesyCarCharge", "mode": "fixed", "base": "total", "value": 3000, 
          "message": "Charge 3k for 10 day Courtesy car"}
        },
        "priority": 300
      },

      {
      "when": {
          "all": [
            {"fact": "courtesyCarDays", "operator": "greaterThan", "value": 10},
            {"fact": "courtesyCarDays","operator": "lessThanInclusive", "value": 20}
            ]
        },
      "then": {
        "do": "apply-adjustment",
            "with": { "item": "courtesyCarCharge", "mode": "fixed", "base": "total", "value": 6000, 
          "message": "Charge 6k for 20 day Courtesy car"}
        },
        "priority": 300
      },


      {
      "when": {
          "all": [{ "fact":"sumInsured", "operator": "greaterThanInclusive", "value": 1 }] },
      "then": {
        "do": "apply-adjustment",
            "with": { "item": "grossPremium", "mode": "expression", "value":"basePremium + aaCharge + windscreenCharge + entertainmentCharge + courtesyCarCharge", "context": ["basePremium", "aaCharge", "windscreenCharge","entertainmentCharge", "courtesyCarCharge"], 
          "message": "Compute gross Premium"}
        },
        "priority": 250
      },


       {
        "when": { 
          "all": [{ "fact":"sumInsured", "operator": "greaterThan", "value": 1 }] },
        "then": { 
            "do": "apply-adjustment", 
            "with": { "item": "stampDuty", "mode": "fixed", "value": 40, 
            "message":"Add stamp duty. 40/- fixed"  } 
            },
        "priority": 200
      },
      {
        "when": { 
          "all": [{ "fact":"sumInsured", "operator": "greaterThan", "value": 1 }] },
        "then": { 
            "do": "apply-adjustment", 
            "with": { "item": "itl", "mode": "rate", "base": "grossPremium", "value": 0.002, 
            "message":"Add Training Levy. 0.2% of basePremium"  } 
            },
        "priority": 200
      },
      {
        "when": { 
          "all": [{ "fact":"sumInsured", "operator": "greaterThan", "value": 1 }] },
        "then": { 
            "do": "apply-adjustment", 
            "with": { "item": "phcf", "mode": "rate", "base": "grossPremium", "value": 0.0025, 
              "message":"Add PHCF 0.25% of basePremium"  } 
            },
        "priority": 200
      },

      {
      "when": {
          "all": [{ "fact":"sumInsured", "operator": "greaterThanInclusive", "value": 1 }] },
      "then": {
        "do": "apply-adjustment",
            "with": { "item": "totalPremium", "mode": "expression", "value":"grossPremium + stampDuty + itl + phcf", "context": ["grossPremium", "stampDuty", "itl","phcf"], 
          "message": "Compute gross Premium"}
        },
        "priority": 100
      }
      
  ]

  
  