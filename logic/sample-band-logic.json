[
  {
    "when": { "all": [{ "fact": "age", "operator": "isDefined", "value": true }] },
    "then": { 
      "do": "apply-adjustment", 
      "with": {
          "item": "riskFactor",
          "mode": "range-lookup",
          "base": "age",
          "table": {
            "1-17": 0.5,
            "18-25": 1.5,
            "26-35": 1.2,
            "36-50": 1.0,
            "51-65": 1.3,
            "66-999": 2.5
            },
          "default": 2.0,
          "message": "Calculate age-based risk factor"
        }
      },
    "priority":10
  },

  {
    "when": { "all": [ { "fact": "countryCode", "operator": "isDefined", "value": true }] },
    "then": { 
      "do": "apply-adjustment", 
      "with": {
          "item": "citizenShip",
          "mode": "value-lookup",
          "base": "countryCode",
          "table": {
              "Ke": "Kenyan",
              "uG": "Ugandan",
              "tz": "Tanzanian",
              "CN": "Chinese"
            },
          "default": "Undefined Country",
          "message": "Map code to country"
        }
      },
    "priority":10
  },

  {
    "when": { 
      "all": [
          { "fact":"category", "operator": "inIgnoreCase", "value": ["VIP", "PREMIUM", "BASIC"] },
          { "fact": "quantity", "operator": "greaterThan", "value": 0 }
        ] 
      },
    "then": { 
      "do": "apply-adjustment", 
      "with": {
        "item": "points",
        "mode": "value-range-lookup",
        "key": "category",
        "base": "quantity",
        "table": {
          "VIP": {
            "0-40": 5500,
            "41-75": 8900,
            "76-999": 19890
            },
          "PREMIUM": {
            "0-40": 6115,
            "41-54": 10584,
            "55-65": 15084,
            "66-75": 20128,
            "76-999": 25918
            },
          "BASIC": {
            "0-40": 6727,
            "41-54": 11643,
            "55-999": 17043
            }
          },
        "default": 1,
        "message": "Award points based on quantity bought and customer category"
        }
      },
    "priority":5
    }
]
  