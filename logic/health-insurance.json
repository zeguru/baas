[
  {
    "when": {
      "any": [
        {"fact":"age", "operator": "lessThan", "value": 0.0},
        {"fact":"age","operator": "greaterThan", "value": 99.0}
        ]
      },
    "then": {
      "do": "validation",
      "with": { "break": true, "message": "Invalid age. Age must be between 1 and 99"} 
      },
    "priority": 500

  },

