[
  {
    "when": { "all": [{ "fact": "dob", "operator": "isDefined", "value":true }] },
    "then": {
      "do": "apply-adjustment",
      "with": { 
        "item": "memberAge", 
        "mode": "expression", 
        "value": "age(dob)", 
        "message": "Compute member age from dob" 
        }
      },
    "priority": 500
  },

  {
    "when": { "all": [{ "fact": "memberAge", "operator": "lessThan", "value": 18 }] },
    "then": {
      "do": "validation",
      "with": {"break": true, "message": "Member must be at least 18 years old" }
      },
    "priority": 400
  },

  {
    "when": { "all": [{ "fact": "initialContribution", "operator": "lessThan", "value": 1000 }] },
    "then": {
      "do": "validation",
      "with": { "break": true, "message": "Minimum initial contribution is 1000/-" }
      },
    "priority": 400
  },

  {
    "when": {
      "all": [{ "fact": "always", "operator": "always", "value": true } ]
      },
    "then": {
      "do": "advice",
      "with": {
        "message": "Cleared: Proceed with onboarding"
        }
      },
    "priority":10
  }
  
]
