[  


  {
    "when": {
      "all": [
        { "fact": "sessionID", "operator": "isDefined", "value": true },
        { "fact": "input", "operator": "isDefined", "value": true },
        { "fact": "session.state.step", "operator": "equalIgnoreCase", "value": "DEFAULT" } ]
      },
    "then": {
      "do": "apply-adjustment",
      "with": {
        "item":"start",
        "mode": "expression", 
        "value": "currentDateTime", 
        "break": true,
        "message": "Choose Title. 1 Mr, 2 Mrs, 3 Miss, 4 Dr"
        }
      },
    "priority":100
  },

  {
    "when": {
      "all": [ 
        { "fact": "session.state.step", "operator": "equalIgnoreCase", "value": "START" },
        { "fact":"input", "operator": "notInIgnoreCase", "value": ["1","2","3","4"] }
        ]
      },
    "then": {
      "do": "validation",
      "with": {
        "break": true, 
        "message": "Invalid title. Expecting input to be 1,2,3 or 4" 
        }        
      },
    "priority": 90
  },

  {
    "when": {
      "all": [{ "fact": "input", "operator": "isDefined", "value": true },
              { "fact": "session.state.step", "operator": "equalIgnoreCase", "value": "START" } ]
      },
    "then": { 
      "do": "apply-adjustment", 
      "with": {
          "item": "title",
          "mode": "value-lookup",
          "base": "input",
          "table": {
              "1": "Mr",
              "2": "Mrs",
              "3": "Miss",
              "4": "Dr"           
              },
          "default": "X",
          "break": true,
          "message": "Whats your hobby ? 1 Sports 2 Travel 3 Gaming 4 None"
          }
        },
    "priority":80
  },


  {
    "when": {
      "all": [ 
        { "fact": "session.state.step", "operator": "equalIgnoreCase", "value": "TITLE" },
        { "fact":"input", "operator": "notInIgnoreCase", "value": ["1","2","3","4"] }
        ]
      },
    "then": {
      "do": "validation",
      "with": {
        "break": true, 
        "message": "Invalid hobby. Expecting input to be 1,2,3 or 4" 
        }        
      },
    "priority": 75
  },

  {
    "when": {
      "all": [{ "fact": "session.state.step", "operator": "equalIgnoreCase", "value": "TITLE" } ]
      },
    "then": { 
      "do": "apply-adjustment", 
      "with": {
          "item": "hobby",
          "mode": "value-lookup",
          "base": "input",
          "table": {
              "1": "Sports",
              "2": "Travel",
              "3": "Gaming",
              "4": "None"
              },
          "default": "X",
          "message": "Saving hobby in the background "
          }
        },
    "priority":70
  },
    
  {
    "when": {
      "all": [
        { "fact": "session.state.step", "operator": "equalIgnoreCase", "value": "TITLE" },
        { "fact": "session.state.title", "operator": "equalIgnoreCase", "value": "MR" }
        ]
      },
    "then": {
      "do": "apply-adjustment", 
      "with": {
        "item": "branch",
        "mode": "fixed",
        "value": "male",
        "message": "What is your favorite car ?",
        "break": true
        }
      },
    "priority":60
  },


    {
    "when": {
      "all": [
        { "fact": "session.state.step", "operator": "equalIgnoreCase", "value": "TITLE" },
        { "fact": "session.state.title", "operator": "inIgnoreCase", "value": ["MRS","MISS","DR"] }
        ]
      },
    "then": {
      "do": "apply-adjustment", 
      "with": {
        "item": "branch",
        "mode": "fixed",
        "value": "female respondent",
        "message": "What is your favorite pet ?",
        "break": true
        }
      },
    "priority":60
  },



  {
    "when": {
      "all": [
        { "fact": "session.state.step", "operator": "equalIgnoreCase", "value": "BRANCH" }
        ]
      },
    "then": {
      "do": "apply-adjustment", 
      "with": {
        "item": "favorite",
        "mode": "expression",
        "value": "input",
        "message": "Thank you for completing the survey. Press any key to exit."
        }
      },
    "priority":50
  },

  {
    "when": {
      "all": [
        { "fact": "session.state.step", "operator": "equalIgnoreCase", "value": "FAVORITE" }
        ]
      },
    "then": {
      "do": "apply-adjustment", 
      "with": {
        "item": "end",
        "mode": "expression",
        "value": "currentDateTime",
        "message": "Survey Completed"
        }
      },
    "priority":40
  }

]
